<Window x:Class="Vehicles.WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vehicles" Height="520" Width="720" MinHeight="480" MinWidth="650"
        WindowStartupLocation="CenterScreen" Background="#F4F6F9" FontFamily="Segoe UI">

    <Grid Margin="20">
        <Border Background="White" CornerRadius="12" Padding="20">
            <Border.Effect>
                <DropShadowEffect Color="#B0BAC9" Direction="270" ShadowDepth="4" BlurRadius="12" Opacity="0.25"/>
            </Border.Effect>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="230"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <DockPanel Grid.Column="0" Margin="0,0,20,0">
                    <TextBlock Text="Sõidukid" FontSize="15" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,0,0,10" DockPanel.Dock="Top"/>

                    <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                        <TextBlock Text="Uue sõiduki andmed:" FontSize="12" Foreground="#64748B" Margin="0,0,0,4"/>
                        <TextBox x:Name="NewMakeBox" Text="Mark" Margin="0,0,0,4" Height="26" VerticalContentAlignment="Center" Padding="4,0" BorderBrush="#CBD5E1"/>
                        <TextBox x:Name="NewModelBox" Text="Mudel" Margin="0,0,0,8" Height="26" VerticalContentAlignment="Center" Padding="4,0" BorderBrush="#CBD5E1"/>

                        <UniformGrid Columns="3">
                            <Button Content="+ Auto" Click="AddCar_Click" Margin="0,0,2,0" Height="28" Background="#EBF3FB" Foreground="#0066CC" BorderBrush="#C5DCF4"/>
                            <Button Content="+ Paat" Click="AddBoat_Click" Margin="2,0" Height="28" Background="#EBF3FB" Foreground="#0066CC" BorderBrush="#C5DCF4"/>
                            <Button Content="+ Amfiib" Click="AddAmphibian_Click" Margin="2,0,0,0" Height="28" Background="#EBF3FB" Foreground="#0066CC" BorderBrush="#C5DCF4"/>
                        </UniformGrid>
                    </StackPanel>

                    <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
                        <ListBox x:Name="VehiclesListBox" SelectionChanged="VehiclesListBox_SelectionChanged" 
                                 BorderThickness="0" Background="Transparent" Padding="4" FontSize="13"/>
                    </Border>
                </DockPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="SelectedTitleText" Text="Vali sõiduk nimekirjast" FontSize="18" FontWeight="Bold" Foreground="#1E293B"/>
                    <TextBlock x:Name="OdometerText" Text="Läbisõit: -" FontSize="14" Foreground="#64748B" Margin="0,4,0,16"/>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,16">
                        <TextBlock Text="Vahemaa (km):" VerticalAlignment="Center" FontSize="13" Foreground="#334155" Margin="0,0,10,0"/>
                        <TextBox x:Name="DistanceBox" Width="90" Height="30" Text="10" 
                                 VerticalContentAlignment="Center" HorizontalContentAlignment="Center" 
                                 BorderBrush="#CBD5E1" Background="#F8FAFC" FontSize="13"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Button x:Name="DriveButton" Content="Sõida" Width="90" Height="32" Margin="0,0,10,0" 
                                Click="Drive_Click" Background="#E0F2FE" Foreground="#0284C7" BorderBrush="#BAE6FD" FontWeight="Medium"/>
                        <Button x:Name="SwimButton" Content="Uju" Width="90" Height="32" Margin="0,0,10,0" 
                                Click="Swim_Click" Background="#E0F2FE" Foreground="#0284C7" BorderBrush="#BAE6FD" FontWeight="Medium"/>
                        <Button x:Name="RemoveButton" Content="Eemalda" Width="90" Height="32" 
                                Click="Remove_Click" Background="#FEE2E2" Foreground="#DC2626" BorderBrush="#FECACA" FontWeight="Medium"/>
                    </StackPanel>

                    <TextBlock Text="Tegevuste logi:" FontSize="13" FontWeight="SemiBold" Foreground="#475569" Margin="0,4,0,6"/>
                    <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
                        <TextBox x:Name="LogBox" Height="170" IsReadOnly="True" VerticalScrollBarVisibility="Auto" 
                                 TextWrapping="Wrap" Background="#F8FAFC" BorderThickness="0" Padding="8" 
                                 FontFamily="Consolas" FontSize="12" Foreground="#334155"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>