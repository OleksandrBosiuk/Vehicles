<Window x:Class="Vehicles.WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vehicles Vol 2 - Kaks garaaži" Height="580" Width="820" MinHeight="520" MinWidth="750"
        WindowStartupLocation="CenterScreen" Background="#F4F6F9" FontFamily="Segoe UI">

    <Grid Margin="20">
        <Border Background="White" CornerRadius="12" Padding="20">
            <Border.Effect>
                <DropShadowEffect Color="#B0BAC9" Direction="270" ShadowDepth="4" BlurRadius="12" Opacity="0.25"/>
            </Border.Effect>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Margin="0,0,20,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="Autode garaaž" FontWeight="Bold" FontSize="14" Foreground="#1E293B" DockPanel.Dock="Top" Margin="0,0,0,6"/>
                        <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                            <UniformGrid Columns="2" Margin="0,0,0,4">
                                <Button Content="+ Auto" Click="AddCarToCarGarage_Click" Height="26" Margin="0,0,2,0" Background="#EBF3FB" Foreground="#0284C7"/>
                                <Button Content="+ Amfiib" Click="AddAmphiToCarGarage_Click" Height="26" Margin="2,0,0,0" Background="#EBF3FB" Foreground="#0284C7"/>
                            </UniformGrid>
                            <Button Content="Eemalda autode garaažist" Click="RemoveCarGarage_Click" Height="24" Background="#FEE2E2" Foreground="#DC2626" FontSize="11"/>
                        </StackPanel>
                        <Border BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6">
                            <ListBox x:Name="CarGarageBox" SelectionChanged="CarGarageBox_SelectionChanged" BorderThickness="0" Background="#F8FAFC"/>
                        </Border>
                    </DockPanel>

                    <DockPanel Grid.Row="1" Margin="0,10,0,0">
                        <TextBlock Text="Paatide garaaž" FontWeight="Bold" FontSize="14" Foreground="#1E293B" DockPanel.Dock="Top" Margin="0,0,0,6"/>
                        <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                            <UniformGrid Columns="2" Margin="0,0,0,4">
                                <Button Content="+ Paat" Click="AddBoatToBoatGarage_Click" Height="26" Margin="0,0,2,0" Background="#EBF3FB" Foreground="#0284C7"/>
                                <Button Content="+ Amfiib" Click="AddAmphiToBoatGarage_Click" Height="26" Margin="2,0,0,0" Background="#EBF3FB" Foreground="#0284C7"/>
                            </UniformGrid>
                            <Button Content="Eemalda paatide garaažist" Click="RemoveBoatGarage_Click" Height="24" Background="#FEE2E2" Foreground="#DC2626" FontSize="11"/>
                        </StackPanel>
                        <Border BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6">
                            <ListBox x:Name="BoatGarageBox" SelectionChanged="BoatGarageBox_SelectionChanged" BorderThickness="0" Background="#F8FAFC"/>
                        </Border>
                    </DockPanel>
                </Grid>

                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="SelectedTitleText" Text="Vali sõiduk ühest garaažist" FontSize="18" FontWeight="Bold" Foreground="#1E293B"/>
                    <TextBlock x:Name="OdometerText" Text="Läbisõit: -" FontSize="14" Foreground="#64748B" Margin="0,4,0,16"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <TextBlock Text="Vahemaa (km):" VerticalAlignment="Center" FontSize="13" Foreground="#334155" Margin="0,0,10,0"/>
                        <TextBox x:Name="DistanceBox" Width="80" Height="28" Text="10" 
                                 VerticalContentAlignment="Center" HorizontalContentAlignment="Center" BorderBrush="#CBD5E1"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Button x:Name="MoveButton" Content="Move()" Width="85" Height="32" Margin="0,0,8,0"
                                Click="Move_Click" Background="#EFF6FF" Foreground="#1D4ED8" FontWeight="SemiBold"/>
                        <Button x:Name="DriveButton" Content="Sõida" Width="85" Height="32" Margin="0,0,8,0" 
                                Click="Drive_Click" Background="#E0F2FE" Foreground="#0284C7"/>
                        <Button x:Name="SwimButton" Content="Uju" Width="85" Height="32" 
                                Click="Swim_Click" Background="#E0F2FE" Foreground="#0284C7"/>
                    </StackPanel>

                    <TextBlock Text="Tegevuste logi:" FontSize="13" FontWeight="SemiBold" Foreground="#475569" Margin="0,4,0,6"/>
                    <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
                        <TextBox x:Name="LogBox" Height="240" IsReadOnly="True" VerticalScrollBarVisibility="Auto" 
                                 TextWrapping="Wrap" Background="#F8FAFC" BorderThickness="0" Padding="8" 
                                 FontFamily="Consolas" FontSize="12" Foreground="#334155"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>